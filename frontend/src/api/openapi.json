{
  "openapi": "3.1.0",
  "info": {
    "title": "Centrum rozliczeń",
    "version": "kontrakt"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "tags": [
          "ustawienia"
        ],
        "summary": "Read",
        "operationId": "getSettings",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings/register/choose": {
      "post": {
        "tags": [
          "ustawienia"
        ],
        "summary": "Choose Register",
        "operationId": "chooseRegister",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Choice"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings/periods-directory/choose": {
      "post": {
        "tags": [
          "ustawienia"
        ],
        "summary": "Choose Periods Directory",
        "operationId": "choosePeriodsDirectory",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Choice"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings/theme": {
      "put": {
        "tags": [
          "ustawienia"
        ],
        "summary": "Change Theme",
        "operationId": "changeTheme",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ThemeChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/periods": {
      "get": {
        "tags": [
          "okresy"
        ],
        "summary": "Board",
        "operationId": "getPeriodBoard",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/BoardNotSet"
                    },
                    {
                      "$ref": "#/components/schemas/BoardMissing"
                    },
                    {
                      "$ref": "#/components/schemas/BoardReady"
                    }
                  ],
                  "title": "Response Getperiodboard",
                  "discriminator": {
                    "propertyName": "state",
                    "mapping": {
                      "not_set": "#/components/schemas/BoardNotSet",
                      "missing": "#/components/schemas/BoardMissing",
                      "ready": "#/components/schemas/BoardReady"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/periods/{token}/open": {
      "post": {
        "tags": [
          "okresy"
        ],
        "summary": "Open Period Path",
        "operationId": "openPeriodPath",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Token"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Opened"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/configuration": {
      "get": {
        "tags": [
          "konfiguracja"
        ],
        "summary": "Configuration",
        "operationId": "getConfiguration",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Configuration"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BoardMissing": {
        "properties": {
          "state": {
            "type": "string",
            "const": "missing",
            "title": "State"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state",
          "name"
        ],
        "title": "BoardMissing"
      },
      "BoardNotSet": {
        "properties": {
          "state": {
            "type": "string",
            "const": "not_set",
            "title": "State"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state"
        ],
        "title": "BoardNotSet"
      },
      "BoardReady": {
        "properties": {
          "state": {
            "type": "string",
            "const": "ready",
            "title": "State"
          },
          "periods": {
            "items": {
              "$ref": "#/components/schemas/PeriodRow"
            },
            "type": "array",
            "title": "Periods"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state",
          "periods"
        ],
        "title": "BoardReady"
      },
      "Choice": {
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "chosen",
              "cancelled"
            ],
            "title": "Outcome"
          },
          "settings": {
            "$ref": "#/components/schemas/Settings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "outcome",
          "settings"
        ],
        "title": "Choice",
        "description": "Wynik natywnego okna wyboru: ``chosen`` zapisuje ścieżkę, ``cancelled`` niczego nie zmienia."
      },
      "Configuration": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version"
          },
          "templates": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/TemplateReady"
                },
                {
                  "$ref": "#/components/schemas/TemplateProblem"
                }
              ],
              "discriminator": {
                "propertyName": "state",
                "mapping": {
                  "problem": "#/components/schemas/TemplateProblem",
                  "ready": "#/components/schemas/TemplateReady"
                }
              }
            },
            "type": "array",
            "title": "Templates"
          },
          "workers": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/WorkersReady"
              },
              {
                "$ref": "#/components/schemas/WorkersUnreadable"
              }
            ],
            "title": "Workers",
            "discriminator": {
              "propertyName": "state",
              "mapping": {
                "ready": "#/components/schemas/WorkersReady",
                "unreadable": "#/components/schemas/WorkersUnreadable"
              }
            }
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "templates",
          "workers"
        ],
        "title": "Configuration",
        "description": "Konfiguracja tylko do odczytu, wyliczana z katalogu konfiguracji przy każdym odczycie."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "service": {
            "type": "string",
            "const": "centrum-rozliczen",
            "title": "Service"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "service",
          "version"
        ],
        "title": "Health"
      },
      "Message": {
        "properties": {
          "what": {
            "type": "string",
            "title": "What"
          },
          "where": {
            "type": "string",
            "title": "Where"
          },
          "action": {
            "type": "string",
            "title": "Action"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "what",
          "where",
          "action"
        ],
        "title": "Message",
        "description": "Komunikat w trzech częściach, ta sama treść co w terminalu."
      },
      "MissingPath": {
        "properties": {
          "state": {
            "type": "string",
            "const": "missing",
            "title": "State"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state",
          "path",
          "name"
        ],
        "title": "MissingPath",
        "description": "Zapamiętana ścieżka, pod którą nie ma już pliku albo folderu."
      },
      "NextStep": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "prepare_collective_file",
              "create_worker_settlements",
              "none"
            ],
            "title": "Action"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "hint": {
            "type": "string",
            "title": "Hint"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "label",
          "hint"
        ],
        "title": "NextStep",
        "description": "Podpowiedź następnego kroku okresu; ``none``, gdy okres jest zamknięty."
      },
      "NotSetPath": {
        "properties": {
          "state": {
            "type": "string",
            "const": "not_set",
            "title": "State"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state"
        ],
        "title": "NotSetPath",
        "description": "Ścieżka jeszcze niewskazana albo plik ustawień nieczytelny."
      },
      "OpenRequest": {
        "properties": {
          "target": {
            "type": "string",
            "enum": [
              "internal_settlement",
              "collective_file",
              "period_folder",
              "worker_settlements_folder"
            ],
            "title": "Target"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "target"
        ],
        "title": "OpenRequest",
        "description": "Co otworzyć w okresie; ścieżkę wylicza serwer z folderu okresów, nigdy z żądania."
      },
      "Opened": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Opened"
      },
      "PeriodRow": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "tuesday": {
            "type": "string",
            "format": "date",
            "title": "Tuesday"
          },
          "monday": {
            "type": "string",
            "format": "date",
            "title": "Monday"
          },
          "status": {
            "type": "string",
            "enum": [
              "no_period_files",
              "collective_file_prepared",
              "worker_settlements_ready"
            ],
            "title": "Status"
          },
          "status_label": {
            "type": "string",
            "title": "Status Label"
          },
          "period_folder_exists": {
            "type": "boolean",
            "title": "Period Folder Exists"
          },
          "internal_settlement_exists": {
            "type": "boolean",
            "title": "Internal Settlement Exists"
          },
          "collective_file_exists": {
            "type": "boolean",
            "title": "Collective File Exists"
          },
          "worker_settlements_folder_exists": {
            "type": "boolean",
            "title": "Worker Settlements Folder Exists"
          },
          "worker_settlement_count": {
            "type": "integer",
            "title": "Worker Settlement Count"
          },
          "last_complete": {
            "type": "boolean",
            "title": "Last Complete"
          },
          "next_step": {
            "$ref": "#/components/schemas/NextStep"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "token",
          "tuesday",
          "monday",
          "status",
          "status_label",
          "period_folder_exists",
          "internal_settlement_exists",
          "collective_file_exists",
          "worker_settlements_folder_exists",
          "worker_settlement_count",
          "last_complete",
          "next_step"
        ],
        "title": "PeriodRow",
        "description": "Jeden okres Tablicy okresów, wyliczony z plików przy każdym odczycie."
      },
      "Problem": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "Problem",
        "description": "Odmowa wykonania żądania z bezpiecznym komunikatem dla taty, bez tekstu wyjątku."
      },
      "ReadyPath": {
        "properties": {
          "state": {
            "type": "string",
            "const": "ready",
            "title": "State"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state",
          "path",
          "name"
        ],
        "title": "ReadyPath"
      },
      "Settings": {
        "properties": {
          "order_register": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/NotSetPath"
              },
              {
                "$ref": "#/components/schemas/MissingPath"
              },
              {
                "$ref": "#/components/schemas/ReadyPath"
              }
            ],
            "title": "Order Register",
            "discriminator": {
              "propertyName": "state",
              "mapping": {
                "missing": "#/components/schemas/MissingPath",
                "not_set": "#/components/schemas/NotSetPath",
                "ready": "#/components/schemas/ReadyPath"
              }
            }
          },
          "periods_directory": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/NotSetPath"
              },
              {
                "$ref": "#/components/schemas/MissingPath"
              },
              {
                "$ref": "#/components/schemas/ReadyPath"
              }
            ],
            "title": "Periods Directory",
            "discriminator": {
              "propertyName": "state",
              "mapping": {
                "missing": "#/components/schemas/MissingPath",
                "not_set": "#/components/schemas/NotSetPath",
                "ready": "#/components/schemas/ReadyPath"
              }
            }
          },
          "theme": {
            "type": "string",
            "enum": [
              "dark",
              "light"
            ],
            "title": "Theme"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "order_register",
          "periods_directory",
          "theme"
        ],
        "title": "Settings"
      },
      "TemplateProblem": {
        "properties": {
          "state": {
            "type": "string",
            "const": "problem",
            "title": "State"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "file_name": {
            "type": "string",
            "title": "File Name"
          },
          "problem": {
            "type": "string",
            "enum": [
              "missing",
              "open_in_excel",
              "unreadable"
            ],
            "title": "Problem"
          },
          "message": {
            "$ref": "#/components/schemas/Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state",
          "label",
          "file_name",
          "problem",
          "message"
        ],
        "title": "TemplateProblem",
        "description": "Wzorca nie ma, jest otwarty w Excelu albo nie przechodzi Sprawdzania."
      },
      "TemplateReady": {
        "properties": {
          "state": {
            "type": "string",
            "const": "ready",
            "title": "State"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "file_name": {
            "type": "string",
            "title": "File Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state",
          "label",
          "file_name"
        ],
        "title": "TemplateReady",
        "description": "Wzorzec jest na miejscu, nie jest otwarty i przechodzi Sprawdzanie."
      },
      "ThemeChange": {
        "properties": {
          "theme": {
            "type": "string",
            "enum": [
              "dark",
              "light"
            ],
            "title": "Theme"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "theme"
        ],
        "title": "ThemeChange"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WorkersReady": {
        "properties": {
          "state": {
            "type": "string",
            "const": "ready",
            "title": "State"
          },
          "names": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Names"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state",
          "names"
        ],
        "title": "WorkersReady",
        "description": "Nazwy Wykonawców w kolejności z konfiguracji wykonawców."
      },
      "WorkersUnreadable": {
        "properties": {
          "state": {
            "type": "string",
            "const": "unreadable",
            "title": "State"
          },
          "message": {
            "$ref": "#/components/schemas/Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state",
          "message"
        ],
        "title": "WorkersUnreadable"
      }
    }
  }
}
