{
  "openapi": "3.1.0",
  "info": {
    "title": "Centrum rozliczeń",
    "version": "kontrakt"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "tags": [
          "ustawienia"
        ],
        "summary": "Read",
        "operationId": "getSettings",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings/register/choose": {
      "post": {
        "tags": [
          "ustawienia"
        ],
        "summary": "Choose Register",
        "operationId": "chooseRegister",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Choice"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings/periods-directory/choose": {
      "post": {
        "tags": [
          "ustawienia"
        ],
        "summary": "Choose Periods Directory",
        "operationId": "choosePeriodsDirectory",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Choice"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings/theme": {
      "put": {
        "tags": [
          "ustawienia"
        ],
        "summary": "Change Theme",
        "operationId": "changeTheme",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ThemeChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/periods": {
      "get": {
        "tags": [
          "okresy"
        ],
        "summary": "Board",
        "operationId": "getPeriodBoard",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/BoardNotSet"
                    },
                    {
                      "$ref": "#/components/schemas/BoardMissing"
                    },
                    {
                      "$ref": "#/components/schemas/BoardReady"
                    }
                  ],
                  "title": "Response Getperiodboard",
                  "discriminator": {
                    "propertyName": "state",
                    "mapping": {
                      "not_set": "#/components/schemas/BoardNotSet",
                      "missing": "#/components/schemas/BoardMissing",
                      "ready": "#/components/schemas/BoardReady"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/periods/{token}/open": {
      "post": {
        "tags": [
          "okresy"
        ],
        "summary": "Open Period Path",
        "operationId": "openPeriodPath",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Token"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Opened"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/metrics": {
      "get": {
        "tags": [
          "metryki"
        ],
        "summary": "Metrics",
        "operationId": "getMetrics",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Metrics"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BoardMissing": {
        "properties": {
          "state": {
            "type": "string",
            "const": "missing",
            "title": "State"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state",
          "name"
        ],
        "title": "BoardMissing"
      },
      "BoardNotSet": {
        "properties": {
          "state": {
            "type": "string",
            "const": "not_set",
            "title": "State"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state"
        ],
        "title": "BoardNotSet"
      },
      "BoardReady": {
        "properties": {
          "state": {
            "type": "string",
            "const": "ready",
            "title": "State"
          },
          "periods": {
            "items": {
              "$ref": "#/components/schemas/PeriodRow"
            },
            "type": "array",
            "title": "Periods"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state",
          "periods"
        ],
        "title": "BoardReady"
      },
      "Choice": {
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "chosen",
              "cancelled"
            ],
            "title": "Outcome"
          },
          "settings": {
            "$ref": "#/components/schemas/Settings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "outcome",
          "settings"
        ],
        "title": "Choice",
        "description": "Wynik natywnego okna wyboru: ``chosen`` zapisuje ścieżkę, ``cancelled`` niczego nie zmienia."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "service": {
            "type": "string",
            "const": "centrum-rozliczen",
            "title": "Service"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "service",
          "version"
        ],
        "title": "Health"
      },
      "Metrics": {
        "properties": {
          "phases": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Phases"
          },
          "minimum_completed_runs": {
            "type": "integer",
            "title": "Minimum Completed Runs"
          },
          "runs": {
            "items": {
              "$ref": "#/components/schemas/ProcessRun"
            },
            "type": "array",
            "title": "Runs"
          },
          "statistics": {
            "items": {
              "$ref": "#/components/schemas/ModeStatistics"
            },
            "type": "array",
            "title": "Statistics"
          },
          "recent": {
            "$ref": "#/components/schemas/RecentResults"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "phases",
          "minimum_completed_runs",
          "runs",
          "statistics",
          "recent"
        ],
        "title": "Metrics",
        "description": "Historia Uruchomień procesu z obu plików metryk, czytanych przy każdym odczycie, od najnowszego."
      },
      "MissingPath": {
        "properties": {
          "state": {
            "type": "string",
            "const": "missing",
            "title": "State"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state",
          "path",
          "name"
        ],
        "title": "MissingPath",
        "description": "Zapamiętana ścieżka, pod którą nie ma już pliku albo folderu."
      },
      "ModeStatistics": {
        "properties": {
          "process": {
            "type": "string",
            "enum": [
              "preparation",
              "settlement"
            ],
            "title": "Process"
          },
          "mode": {
            "type": "string",
            "enum": [
              "RUN",
              "DRY-RUN"
            ],
            "title": "Mode"
          },
          "completed_runs": {
            "type": "integer",
            "title": "Completed Runs"
          },
          "percentiles": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Percentiles"
              },
              {
                "type": "null"
              }
            ]
          },
          "results": {
            "$ref": "#/components/schemas/ResultCounts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "process",
          "mode",
          "completed_runs",
          "percentiles",
          "results"
        ],
        "title": "ModeStatistics",
        "description": "Statystyki jednego procesu w jednym trybie; bez ``percentiles`` poniżej minimum ukończonych obserwacji."
      },
      "NextStep": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "prepare_collective_file",
              "create_worker_settlements",
              "none"
            ],
            "title": "Action"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "hint": {
            "type": "string",
            "title": "Hint"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "label",
          "hint"
        ],
        "title": "NextStep",
        "description": "Podpowiedź następnego kroku okresu; ``none``, gdy okres jest zamknięty."
      },
      "NotSetPath": {
        "properties": {
          "state": {
            "type": "string",
            "const": "not_set",
            "title": "State"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state"
        ],
        "title": "NotSetPath",
        "description": "Ścieżka jeszcze niewskazana albo plik ustawień nieczytelny."
      },
      "OpenRequest": {
        "properties": {
          "target": {
            "type": "string",
            "enum": [
              "internal_settlement",
              "collective_file",
              "period_folder",
              "worker_settlements_folder"
            ],
            "title": "Target"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "target"
        ],
        "title": "OpenRequest",
        "description": "Co otworzyć w okresie; ścieżkę wylicza serwer z folderu okresów, nigdy z żądania."
      },
      "Opened": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Opened"
      },
      "Percentiles": {
        "properties": {
          "p50_ms": {
            "type": "integer",
            "title": "P50 Ms"
          },
          "p95_ms": {
            "type": "integer",
            "title": "P95 Ms"
          },
          "phases": {
            "items": {
              "$ref": "#/components/schemas/PhasePercentiles"
            },
            "type": "array",
            "title": "Phases"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "p50_ms",
          "p95_ms",
          "phases"
        ],
        "title": "Percentiles",
        "description": "P50 i P95 czasu całego Uruchomienia procesu i każdego etapu, w milisekundach."
      },
      "PeriodRow": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "tuesday": {
            "type": "string",
            "format": "date",
            "title": "Tuesday"
          },
          "monday": {
            "type": "string",
            "format": "date",
            "title": "Monday"
          },
          "status": {
            "type": "string",
            "enum": [
              "no_period_files",
              "collective_file_prepared",
              "worker_settlements_ready"
            ],
            "title": "Status"
          },
          "status_label": {
            "type": "string",
            "title": "Status Label"
          },
          "period_folder_exists": {
            "type": "boolean",
            "title": "Period Folder Exists"
          },
          "internal_settlement_exists": {
            "type": "boolean",
            "title": "Internal Settlement Exists"
          },
          "collective_file_exists": {
            "type": "boolean",
            "title": "Collective File Exists"
          },
          "worker_settlements_folder_exists": {
            "type": "boolean",
            "title": "Worker Settlements Folder Exists"
          },
          "worker_settlement_count": {
            "type": "integer",
            "title": "Worker Settlement Count"
          },
          "last_complete": {
            "type": "boolean",
            "title": "Last Complete"
          },
          "next_step": {
            "$ref": "#/components/schemas/NextStep"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "token",
          "tuesday",
          "monday",
          "status",
          "status_label",
          "period_folder_exists",
          "internal_settlement_exists",
          "collective_file_exists",
          "worker_settlements_folder_exists",
          "worker_settlement_count",
          "last_complete",
          "next_step"
        ],
        "title": "PeriodRow",
        "description": "Jeden okres Tablicy okresów, wyliczony z plików przy każdym odczycie."
      },
      "PhaseDuration": {
        "properties": {
          "phase": {
            "type": "string",
            "title": "Phase"
          },
          "duration_ms": {
            "type": "integer",
            "title": "Duration Ms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "phase",
          "duration_ms"
        ],
        "title": "PhaseDuration"
      },
      "PhasePercentiles": {
        "properties": {
          "phase": {
            "type": "string",
            "title": "Phase"
          },
          "p50_ms": {
            "type": "integer",
            "title": "P50 Ms"
          },
          "p95_ms": {
            "type": "integer",
            "title": "P95 Ms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "phase",
          "p50_ms",
          "p95_ms"
        ],
        "title": "PhasePercentiles"
      },
      "Problem": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "Problem",
        "description": "Odmowa wykonania żądania z bezpiecznym komunikatem dla taty, bez tekstu wyjątku."
      },
      "ProcessRun": {
        "properties": {
          "process": {
            "type": "string",
            "enum": [
              "preparation",
              "settlement"
            ],
            "title": "Process"
          },
          "process_label": {
            "type": "string",
            "title": "Process Label"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "mode": {
            "type": "string",
            "enum": [
              "RUN",
              "DRY-RUN"
            ],
            "title": "Mode"
          },
          "period": {
            "type": "string",
            "title": "Period"
          },
          "result": {
            "type": "string",
            "enum": [
              "OK",
              "WYMAGA_SPRAWDZENIA",
              "BLAD_KRYTYCZNY"
            ],
            "title": "Result"
          },
          "total_duration_ms": {
            "type": "integer",
            "title": "Total Duration Ms"
          },
          "phase_durations": {
            "items": {
              "$ref": "#/components/schemas/PhaseDuration"
            },
            "type": "array",
            "title": "Phase Durations"
          },
          "origin": {
            "type": "string",
            "enum": [
              "cmd",
              "centrum"
            ],
            "title": "Origin"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "process",
          "process_label",
          "started_at",
          "mode",
          "period",
          "result",
          "total_duration_ms",
          "phase_durations",
          "origin"
        ],
        "title": "ProcessRun",
        "description": "Jedno Uruchomienie procesu z pliku metryk; ``BLAD_KRYTYCZNY`` to przerwane, z czasami etapów do przerwania.\n\n``origin`` mówi, skąd wystartowało: ``cmd`` to launcher (CLI), ``centrum`` to Centrum rozliczeń."
      },
      "ReadyPath": {
        "properties": {
          "state": {
            "type": "string",
            "const": "ready",
            "title": "State"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state",
          "path",
          "name"
        ],
        "title": "ReadyPath"
      },
      "RecentResults": {
        "properties": {
          "weeks": {
            "type": "integer",
            "title": "Weeks"
          },
          "since": {
            "type": "string",
            "format": "date",
            "title": "Since"
          },
          "results": {
            "$ref": "#/components/schemas/ResultCounts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "weeks",
          "since",
          "results"
        ],
        "title": "RecentResults",
        "description": "Wyniki Uruchomień procesu obu procesów od ``since`` (ostatnie ``weeks`` tygodni)."
      },
      "ResultCounts": {
        "properties": {
          "ok": {
            "type": "integer",
            "title": "Ok"
          },
          "needs_review": {
            "type": "integer",
            "title": "Needs Review"
          },
          "critical": {
            "type": "integer",
            "title": "Critical"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ok",
          "needs_review",
          "critical"
        ],
        "title": "ResultCounts"
      },
      "Settings": {
        "properties": {
          "order_register": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/NotSetPath"
              },
              {
                "$ref": "#/components/schemas/MissingPath"
              },
              {
                "$ref": "#/components/schemas/ReadyPath"
              }
            ],
            "title": "Order Register",
            "discriminator": {
              "propertyName": "state",
              "mapping": {
                "missing": "#/components/schemas/MissingPath",
                "not_set": "#/components/schemas/NotSetPath",
                "ready": "#/components/schemas/ReadyPath"
              }
            }
          },
          "periods_directory": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/NotSetPath"
              },
              {
                "$ref": "#/components/schemas/MissingPath"
              },
              {
                "$ref": "#/components/schemas/ReadyPath"
              }
            ],
            "title": "Periods Directory",
            "discriminator": {
              "propertyName": "state",
              "mapping": {
                "missing": "#/components/schemas/MissingPath",
                "not_set": "#/components/schemas/NotSetPath",
                "ready": "#/components/schemas/ReadyPath"
              }
            }
          },
          "theme": {
            "type": "string",
            "enum": [
              "dark",
              "light"
            ],
            "title": "Theme"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "order_register",
          "periods_directory",
          "theme"
        ],
        "title": "Settings"
      },
      "ThemeChange": {
        "properties": {
          "theme": {
            "type": "string",
            "enum": [
              "dark",
              "light"
            ],
            "title": "Theme"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "theme"
        ],
        "title": "ThemeChange"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
