{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Unused files and dependencies are still reported everywhere; only exports are excused here.
  "ignoreIssues": {
    // generated
    "src/api/generated/**": ["exports", "types", "duplicates"],
    // vendored
    "tools/oxlint/anti-slop/**": ["exports", "types"]
  }
}
