# MAXIMISEART-Dad — Environment Configuration Template
# Copy this file to .env and fill in actual values on target machine.
# NIGDY nie commituj .env do git.

# === RUNTIME PATHS (auto-detected by init_wizard.py) ===
# Główny katalog runtime — vault, state, reports, logs
DAD_RUNTIME_PATH=%USERPROFILE%\MAXIMISEART-Dad-runtime

# Obsidian vault lokalizacja (zazwyczaj w runtime)
DAD_VAULT_PATH=%DAD_RUNTIME_PATH%\vault

# Excel taty (auto-detect via OneDrive glob lub manual path)
# Przykład: C:\Users\Tata\OneDrive\Fiber\raporty-dzienne.xlsx
DAD_EXCEL_PATH=

# Katalog raportów (tata otwiera)
DAD_REPORTS_DIR=%DAD_VAULT_PATH%\reports

# Katalog logów pipeline
DAD_LOGS_DIR=%DAD_RUNTIME_PATH%\logs

# === SCHEDULE ===
# Godzina daily run (24h format, Europe/Warsaw)
DAD_RUN_TIME=06:30

# === RED TEAM GATES ===
# Aggregate gate threshold: (ANSWER / total) >= X → proceed
DAD_RED_TEAM_THRESHOLD=0.66

# High-stakes trigger (PLN) — powyżej tego triple-vote Mut #39
DAD_HIGH_STAKES_PLN=500

# === LEARNING LOOP ===
# Ile dni bez feedback = CRITICAL fatigue alert
DAD_FATIGUE_CRITICAL_DAYS=3

# Retention maili w Brain (dni)
DAD_BRAIN_RETENTION_DAYS=90

# === GMAIL ===
# OAuth token path (created by init_wizard Gmail auth step)
DAD_OAUTH_TOKEN_PATH=%DAD_RUNTIME_PATH%\state\oauth-token.json

# === FEATURE FLAGS ===
# Enable real verification calls (STUB mode default dla testowania)
DAD_USE_REAL_API=false

# Enable cross-lineage voting (Mutation #43 Layer 2)
DAD_CROSS_LINEAGE_VOTE=false

# Enable approval fatigue monitor (Mutation #46)
DAD_FATIGUE_MONITOR=true

# === DEBUG ===
# Log level: DEBUG | INFO | WARNING | ERROR
DAD_LOG_LEVEL=INFO
