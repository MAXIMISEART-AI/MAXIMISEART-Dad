{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR/tools/hooks/czekanie.py\" || python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/czekanie.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR/tools/hooks/usuwanie.py\" || python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/usuwanie.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
